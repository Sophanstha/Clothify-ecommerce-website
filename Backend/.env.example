# Port (Hosting platforms like Render/Railway automatically inject PORT)
PORT=5000

# MongoDB Atlas connection string (Remember to allow 0.0.0.0/0 in MongoDB Atlas Network Access)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clothify?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRITY=your_jwt_strong_secret_key

# Cloudinary credentials for product image uploads
Cloud_name=your_cloudinary_cloud_name
Cloud_APIKEY=your_cloudinary_api_key
Cloud_APISECERT=your_cloudinary_api_secret

# Deployed Frontend URL for CORS
FRONTEND_URL=https://your-frontend.vercel.app
